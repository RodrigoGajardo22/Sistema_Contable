
# Configuración del frontend para DESARROLLO (se versiona).
#
# Vite no carga .env.dev por convención: se carga porque el script `dev`
# ejecuta `vite --mode dev`.

# Base de la API. Relativa a propósito: el gateway (dev y prod) la resuelve.
VITE_API_URL=/api

# Puerto interno del servidor de Vite dentro del contenedor.
VITE_DEV_PORT=5173

# Puerto público por el que el navegador habla con el HMR (el gateway).
VITE_HMR_CLIENT_PORT=8080

# Destino del proxy de Vite cuando se entra directo a :5173.
VITE_PROXY_TARGET=http://backend:5000
