
# Plantilla del frontend. Copiar a frontend/.env.dev (desarrollo).
#
# Vite solo carga este archivo si se ejecuta con `vite --mode dev`.
# En producción no hay archivo de entorno: `src/api/client.ts` usa "/api".

VITE_API_URL=/api
VITE_DEV_PORT=5173
VITE_HMR_CLIENT_PORT=8080
VITE_PROXY_TARGET=http://backend:5000
