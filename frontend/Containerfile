# Etapa base: dependencias resueltas a partir del lockfile
FROM node:22-alpine AS base

WORKDIR /app

ENV CI=true

# Versión de pnpm alineada con el campo `packageManager` de package.json
RUN npm install -g pnpm@10.34.9

COPY frontend/package.json frontend/pnpm-lock.yaml ./

# ---------------------------------------------------------------------------
# Dependencias instaladas (se reutilizan en dev y en build)
# ---------------------------------------------------------------------------
FROM base AS deps

RUN pnpm install --frozen-lockfile

# ---------------------------------------------------------------------------
# Desarrollo: servidor de Vite con HMR.
# El código y node_modules se montan como volúmenes desde compose.
# ---------------------------------------------------------------------------
FROM deps AS dev

EXPOSE 5173

CMD ["pnpm", "dev", "--host", "0.0.0.0"]

# ---------------------------------------------------------------------------
# Build estático
# ---------------------------------------------------------------------------
FROM deps AS build

COPY frontend/ ./

RUN pnpm build

# ---------------------------------------------------------------------------
# Producción: nginx sirviendo el build estático y proxeando /api
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS prod

COPY --from=build /app/dist /usr/share/nginx/html

COPY infra/nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
