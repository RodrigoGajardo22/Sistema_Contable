# Configuración del backend para DESARROLLO (se versiona: no contiene secretos reales).
#
# DATABASE_URL y REDIS_URL no van acá: las construye Compose a partir de
# infra/.env.dev, así las credenciales tienen una única fuente de verdad.

APP_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=1
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# Clave de desarrollo. En producción se define en backend/.env.prod.
JWT_SECRET_KEY=dev-only-no-usar-en-produccion-32-bytes
JWT_ACCESS_MINUTES=15
# 7 días: la sesión se renueva sin pedir credenciales de nuevo.
JWT_REFRESH_MINUTES=10080

# Administrador inicial (lo crea `flask seed`, idempotente).
ADMIN_NOMBRE=Sofía Méndez
ADMIN_EMAIL=admin@estudio.com
ADMIN_PASSWORD=Admin1234

# Orígenes permitidos para CORS (el gateway entra por el puerto 8080).
CORS_ORIGINS=http://localhost:8080
