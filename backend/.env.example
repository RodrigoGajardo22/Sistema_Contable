# Plantilla del backend. Copiar a:
#   backend/.env.dev   -> desarrollo (se versiona)
#   backend/.env.prod  -> producción (NUNCA se versiona)
#
# DATABASE_URL y REDIS_URL las construye Compose a partir de infra/.env.*
# para no duplicar credenciales.

APP_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=1
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambiame
JWT_ACCESS_MINUTES=15
# 7 días: la sesión se renueva sin pedir credenciales de nuevo.
JWT_REFRESH_MINUTES=10080

# Administrador inicial (lo crea `flask seed`, idempotente).
ADMIN_NOMBRE=Sofía Méndez
ADMIN_EMAIL=admin@estudio.com
ADMIN_PASSWORD=cambiame

# Orígenes permitidos para CORS (el gateway entra por el puerto 8080).
CORS_ORIGINS=http://localhost:8080
