# Configuración de la infraestructura para DESARROLLO (se versiona).
# Compose la lee con: --env-file infra/.env.dev
#
# Estos valores son los que construyen DATABASE_URL en compose.yaml,
# así que son la única fuente de verdad para las credenciales de Postgres.

COMPOSE_PROJECT_NAME=sistema-contable

POSTGRES_DB=sistema_contable
POSTGRES_USER=app_user
POSTGRES_PASSWORD=clave_super_segura

# Redis: storage del rate limiting (bloqueo por intentos fallidos).
REDIS_PASSWORD=clave_redis_dev
