# Plantilla de infraestructura. Copiar a:
#   infra/.env.dev   -> desarrollo (se versiona)
#   infra/.env.prod  -> producción (NUNCA se versiona)

COMPOSE_PROJECT_NAME=sistema-contable

POSTGRES_DB=sistema_contable
